#include <iostream>
#include <stdexcept>
using namespace std;

class Counter
{
    int val;
    public:
        Counter(int base = 0):val{base}
        {}

        inline int value()const{return val;}

        inline void reset(){val = 0;}

        inline void increment(int par = 1){this->operator+=(par);}
        void decrement(int par = 1){this->operator-=(par);}
    


        void operator+=(int base){val += base;}
        void operator++(int){val++;}

        void operator-=(int base){
            if(val < base)return;
                val -= base;}
        void operator--(int){
            if(!val)return;
                val--;}

       operator int(){
            return val;
        }
        
            
};

ostream& operator<<(ostream & os, const Counter & cp){
            os << cp.value();
            return os;
        }





template<class T>
class Stack
{
    int limit;

    int curent_size{};
    T *elems;
   

    public:
        Stack(int lim = 1024):elems{new T[lim]}, limit{lim}{}
        ~Stack(){delete[] elems;}

        void push(int x){
            if(curent_size >= limit)throw overflow_error{"Over"};

            elems[curent_size++] = x;
            
          
        }
        int pop(){
            //elems[last_ind] = 0;
            if(curent_size <= 0)throw underflow_error{"Underflow"};
            return elems[--curent_size];
            
        }
        int size()const{return curent_size;}

        int is_empty(){return curent_size == 0;}

        int peek()const{
            
            if(curent_size <= 0)throw underflow_error{"Empty"}
            
            return elems[curent_size-1];}
};





bool assert(int x, int y){
    return (x == y) ? true : false;
}

